{
  "permissions": {
    "allow": [
      "Bash(cargo run:*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-docs-with-code.sh\"",
            "if": "Bash(git push:*)",
            "timeout": 15,
            "statusMessage": "Verificando que la documentación acompañe al código…"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-docs-with-code.sh\"",
            "if": "Bash(gh pr create:*)",
            "timeout": 15,
            "statusMessage": "Verificando que la documentación acompañe al código…"
          }
        ]
      }
    ]
  }
}
