{
    "nodes": {
        "my_webhook": {
            "type": "trigger_webhook",
            "config": {
                "path": "/test-llm",
                "method": "POST"
            }
        },
        "llm_step": {
            "type": "llm_call",
            "config": {
                "provider": "openai",
                "api_key": "OPENAI_API_KEY",
                "model": "gpt-3.5-turbo",
                "system_message": "You are a helpful assistant.",
                "max_tokens": 50
            }
        },
        "log_step": {
            "type": "log"
        }
    },
    "edges": [
        {
            "from": "my_webhook.output.message",
            "to": "llm_step.prompt"
        },
        {
            "from": "llm_step.output",
            "to": "log_step.input"
        }
    ]
}