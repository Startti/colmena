{
    "nodes": {
        "trigger": {
            "type": "trigger_webhook",
            "config": {
                "path": "/agent-demo",
                "method": "POST",
                "test_payload": {
                    "question": "What is inside this image?"
                }
            }
        },
        "agent_llm": {
            "type": "llm_call",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "stream": true,
                "system_message": "You are a helpful analyst.",
                "temperature": 0.0,
                "files": [
                    {
                        "mime_type": "image/png",
                        "path": "../../../tests/dags/test_image.jpg"
                    }
                ]
            }
        }
    },
    "edges": [
        {
            "from": "trigger.output.question",
            "to": "agent_llm.prompt"
        }
    ]
}