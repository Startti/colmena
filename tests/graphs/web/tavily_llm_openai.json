{
  "metadata": {
    "category": "web",
    "requires_env": ["OPENAI_API_KEY", "TAVILY_API_KEY"]
  },
  "nodes": {
    "ask": {
      "type": "input",
      "config": {
        "default": "¿Cuál es la última noticia sobre inteligencia artificial esta semana?"
      }
    },
    "agent": {
      "type": "llm_call",
      "config": {
        "provider": "openai",
        "model": "gpt-4o-mini",
        "api_key": "${OPENAI_API_KEY}",
        "temperature": 0.3,
        "stream": true,
        "system_message": "Eres un asistente de investigación. Usa la tool web__search para buscar información actualizada antes de responder. Prefiere time_range=week para preguntas sobre eventos recientes.",
        "tool_configurations": {
          "web": {
            "name": "web",
            "description": "Web search and fetch via Tavily",
            "node_type": "tavily_client",
            "node_config": {
              "api_key": "${TAVILY_API_KEY}",
              "max_calls_per_run": 5,
              "search_defaults": { "max_results": 5 }
            },
            "expose_sub_tools": "all"
          }
        }
      }
    },
    "sink": {
      "type": "output",
      "config": {}
    }
  },
  "edges": [
    { "from": "ask", "to": "agent", "field": "prompt" },
    { "from": "agent", "to": "sink" }
  ]
}
