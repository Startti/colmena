  "edges": [
    { "comment": "Named target port: origen's full payload arrives intact under the 'origen' key.", "from": "origen", "to": "plantilla.origen" },
    { "comment": "Named target port: cliente's full payload arrives intact under the 'cliente' key.", "from": "cliente", "to": "plantilla.cliente" },
