{
  "nodes": {
    "trigger": {
      "type": "trigger_webhook",
      "config": {
        "path": "/test-document-tools",
        "method": "POST",
        "test_payload": {
          "prompt": "Crea un Excel con una hoja llamada 'Ventas' que tenga A1='Producto', B1='Precio', A2='Manzana', B2=100, A3='Pera', B3=150. Al final dime el artifact_id."
        }
      }
    },
    "agent": {
      "type": "llm_call",
      "config": {
        "provider": "openai",
        "stream": false,
        "api_key": "${OPENAI_API_KEY}",
        "model": "gpt-4o-mini",
        "max_tokens": 2000,
        "temperature": 0,
        "documents": {
          "storage_backend": "localfs",
          "storage_root": "/tmp/colmena_llm_tools_documents"
        }
      }
    },
    "log": {
      "type": "log"
    }
  },
  "edges": [
    { "from": "trigger", "to": "agent" },
    { "from": "agent",   "to": "log" }
  ]
}
