{
  "nodes": {
    "trigger": {
      "type": "trigger_webhook",
      "config": {
        "path": "/img-edit-basic",
        "method": "POST",
        "test_payload": {
          "prompt": "Add a small bright moon in the top-right corner"
        }
      }
    },
    "edit": {
      "type": "image_edit",
      "config": {
        "provider": "openai",
        "model": "gpt-image-1",
        "api_key": "${OPENAI_API_KEY}",
        "source_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/4d/Cat_November_2010-1a.jpg/1024px-Cat_November_2010-1a.jpg",
        "prompt": "Add a small bright moon in the top-right corner",
        "size": "1024x1024",
        "n": 1
      }
    },
    "log_step": { "type": "log" }
  },
  "edges": [
    { "from": "trigger", "to": "edit" },
    { "from": "edit", "to": "log_step" }
  ]
}
