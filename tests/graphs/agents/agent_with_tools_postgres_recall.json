{
  "nodes": {
    "trigger": {
      "type": "trigger_webhook",
      "config": {
        "path": "/agent-memory-demo-2",
        "method": "POST",
        "test_payload": {
          "prompt": "What was the result of my previous calculation? And what were the two operations I asked you to perform?"
        }
      }
    },
    "agent_llm": {
      "type": "llm_call",
      "config": {
        "provider": "openai",
        "api_key": "${OPENAI_API_KEY}",
        "model": "gpt-4o-mini",
        "system_message": "You are a helpful math assistant with a memory. Use the available tools to solve math problems step by step. Remember previous conversations.",
        "temperature": 0.7,
        "connection_url": "${DATABASE_URL}",
        "enabled_tools": [
          "add",
          "multiply",
          "subtract",
          "divide"
        ]
      }
    },
    "log_result": {
      "type": "log"
    }
  },
  "edges": [
    {
      "from": "trigger",
      "to": "agent_llm"
    },
    {
      "from": "agent_llm",
      "to": "log_result"
    }
  ]
}