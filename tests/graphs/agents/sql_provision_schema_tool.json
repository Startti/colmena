{
  "comment": "LLM tool path: the sql_query tool is configured with a fresh schema in allowed_schemas and create_schemas_if_missing=true. The schema 'colmena_tool_provision_e2e' is created at tool init regardless of the query the LLM runs.",
  "metadata": {
    "category": "agents",
    "requires_env": ["GEMINI_API_KEY", "DATABASE_URL"]
  },
  "nodes": {
    "sql_agent": {
      "type": "llm_call",
      "config": {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "api_key": "${GEMINI_API_KEY}",
        "system_message": "You are a data analyst. Use the query_database tool exactly once to run the query: SELECT 1 AS ok",
        "enabled_tools": ["query_database"],
        "stream": false,
        "tool_configurations": {
          "query_database": {
            "name": "query_database",
            "node_type": "sql_query",
            "description": "Query the database.",
            "node_schema": {
              "connection_url": { "type": "string", "fixed": "${DATABASE_URL}" },
              "permissions": {
                "type": "object",
                "fixed": {
                  "preset": "read_only",
                  "allowed_schemas": ["colmena_tool_provision_e2e"],
                  "create_schemas_if_missing": true
                }
              },
              "guardrail_enabled": { "type": "boolean", "fixed": true },
              "guardrail_llm": { "type": "object", "fixed": { "enabled": false } },
              "query": {
                "type": "string",
                "required": true,
                "description": "SQL SELECT query to execute."
              }
            }
          }
        },
        "prompt": "Run SELECT 1 AS ok and tell me the result."
      }
    },
    "result": {
      "type": "output",
      "config": { "label": "SQL Agent Result" }
    }
  },
  "edges": [
    { "from": "sql_agent", "to": "result" }
  ]
}
