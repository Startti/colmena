{
  "nodes": {
    "start": {
      "type": "trigger_webhook",
      "config": {
        "path": "/mcp-github-credentialed",
        "method": "POST",
        "test_payload": {
          "prompt": "Listá los pull requests abiertos del repositorio Startti/colmena. Para cada uno decime número, título y autor. Usá las herramientas de GitHub que tenés. Si no hay ninguno, decilo; no inventes."
        }
      }
    },
    "agent": {
      "type": "llm_call",
      "config": {
        "provider": "google",
        "api_key": "${GEMINI_API_KEY}",
        "model": "gemini-2.5-flash",
        "system_message": "Sos un asistente técnico. Usá las herramientas disponibles para responder. Si una herramienta falla, reportá el fallo tal cual; nunca inventes el contenido que la herramienta no devolvió.",
        "prompt": "{{prompt}}",
        "max_tokens": 900,
        "stream": true,
        "tool_configurations": {
          "github": {
            "node_type": "mcp",
            "mcp": {
              "url": "https://api.githubcopilot.com/mcp/",
              "headers": {
                "Authorization": "<sv_github_token>",
                "X-MCP-Readonly": "true",
                "X-MCP-Toolsets": "pull_requests,repos"
              },
              "timeout_seconds": 45
            }
          }
        }
      }
    },
    "out": {
      "type": "log"
    }
  },
  "edges": [
    { "from": "start", "to": "agent" },
    { "from": "agent", "to": "out" }
  ]
}
