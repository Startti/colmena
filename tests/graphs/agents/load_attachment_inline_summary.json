{
  "$comment": "E2E smoke test for inline data: base64 auto-summary path. Uses the 580B hello.pdf fixture as data: URI (no path, no url). Run with a stable --agent-session-id (e.g. inline_summary_e2e_001) and query conversation_attachments afterwards to confirm description IS NOT NULL for document_id starting with 'inline_'.",
  "nodes": {
    "uploader": {
      "type": "llm_call",
      "config": {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "api_key": "${GEMINI_API_KEY}",
        "connection_url": "${DATABASE_URL}",
        "attachments_enabled": true,
        "summary_enabled": true,
        "system_message": "You are an upload acknowledger. Reply in one short sentence confirming the document was received. Do not describe its contents.",
        "prompt": "Confirma que recibiste el documento adjunto.",
        "files": [
          {
            "id": "inline_doc_e2e_001",
            "label": "Hello PDF inline fixture",
            "data": "",
            "mime_type": "application/pdf",
            "filename": "hello.pdf"
          }
        ]
      }
    },
    "out": { "type": "log" }
  },
  "edges": [
    { "from": "uploader", "to": "out" }
  ]
}
