                                                            "to": "out"
                                                          }
                                                        ]
                                                      }
                                                    }
                                                  },
                                                  "out": {
                                                    "type": "output",
                                                    "config": {}
                                                  }
                                                },
                                                "edges": [
                                                  {
                                                    "from": "in",
                                                    "to": "deeper"
                                                  },
                                                  {
                                                    "from": "deeper",
                                                    "to": "out"
                                                  }
                                                ]
                                              }
                                            }
                                          },
                                          "out": {
                                            "type": "output",
                                            "config": {}
                                          }
                                        },
                                        "edges": [
                                          {
                                            "from": "in",
                                            "to": "deeper"
                                          },
                                          {
                                            "from": "deeper",
                                            "to": "out"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "out": {
                                    "type": "output",
                                    "config": {}
                                  }
