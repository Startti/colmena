{
  "comment": "E2E de la remediación de anidación/SSE (2026-08-21). Un solo run ejercita: profundidad sin tope (cadena de 6 subgrafos anidados, antes rechazada en 5), frontera de subgraph-as-tool, anidación del contenido bajo su frontera, llm_call-as-tool como nivel propio, bloques de texto por rama concurrente, y thinking del planner al nivel de su node-start. El system_message pide las tres tools explícitamente A PROPÓSITO: esto verifica el cableado del stream, no la autonomía del agente.",
  "metadata": {
    "category": "advanced",
    "features": [
      "nested_visibility",
      "level_path",
      "subgraph_as_tool",
      "llm_call_as_tool",
      "for_each",
      "orchestrator",
      "unbounded_depth"
    ],
    "requires_env": [
      "GEMINI_API_KEY",
      "DATABASE_URL"
    ]
  },
  "nodes": {
    "trigger": {
      "type": "input",
      "config": {
        "prompt": "Ejecuta la verificación completa: llama a `cadena_profunda`, a `experto_directo` y a `abanico`, y resume en dos frases lo que devolvió cada una."
      }
    },
    "coordinador": {
      "type": "llm_call",
      "config": {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "api_key": "${GEMINI_API_KEY}",
        "temperature": 0,
        "system_message": "Eres un coordinador de verificación. Llama EXACTAMENTE UNA VEZ a cada una de tus tres tools: `cadena_profunda`, `experto_directo` y `abanico`. Para `abanico` usa dos filas. Cuando tengas las tres respuestas, resume brevemente lo que devolvió cada una.",
        "stream": true,
        "tool_configurations": {
          "cadena_profunda": {
            "name": "cadena_profunda",
            "node_type": "subgraph",
            "description": "Recorre una cadena de sub-grafos anidados y devuelve la profundidad alcanzada.",
            "fixed_config": {
              "child_graph_inline": {
                "nodes": {
                  "in": {
                    "type": "input",
                    "config": {}
                  },
                  "deeper": {
                    "type": "subgraph",
                    "config": {
                      "child_graph_inline": {
                        "nodes": {
                          "in": {
                            "type": "input",
                            "config": {}
                          },
                          "deeper": {
                            "type": "subgraph",
                            "config": {
                              "child_graph_inline": {
                                "nodes": {
                                  "in": {
                                    "type": "input",
                                    "config": {}
                                  },
                                  "deeper": {
                                    "type": "subgraph",
                                    "config": {
                                      "child_graph_inline": {
                                        "nodes": {
                                          "in": {
                                            "type": "input",
                                            "config": {}
                                          },
                                          "deeper": {
                                            "type": "subgraph",
                                            "config": {
                                              "child_graph_inline": {
                                                "nodes": {
                                                  "in": {
                                                    "type": "input",
                                                    "config": {}
                                                  },
                                                  "deeper": {
                                                    "type": "subgraph",
                                                    "config": {
                                                      "child_graph_inline": {
                                                        "nodes": {
                                                          "in": {
                                                            "type": "input",
                                                            "config": {}
                                                          },
                                                          "deeper": {
                                                            "type": "subgraph",
                                                            "config": {
                                                              "child_graph_inline": {
                                                                "nodes": {
                                                                  "in": {
                                                                    "type": "input",
                                                                    "config": {}
                                                                  },
                                                                  "probe": {
                                                                    "type": "python_script",
                                                                    "config": {
                                                                      "code": "output = {\"depth_reached\": globals().get(\"__colmena_subgraph_depth\", -1)}"
                                                                    }
                                                                  },
                                                                  "out": {
                                                                    "type": "output",
                                                                    "config": {}
                                                                  }
                                                                },
                                                                "edges": [
                                                                  {
