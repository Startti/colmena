{
  "nodes": {
    "get_token": {
      "type": "http_request",
      "config": {
        "base_url": "https://httpbin.org",
        "endpoint": "/post",
        "method": "POST",
        "secure": true,
        "body": {
          "token": "sk_live_abc123xyz",
          "client_id": "my_client"
        }
      }
    },
    "use_token_in_header": {
      "type": "http_request",
      "config": {
        "base_url": "https://httpbin.org",
        "endpoint": "/bearer",
        "method": "GET"
      }
    },
    "output_node": {
      "type": "log"
    }
  },
  "edges": [
    {
      "from": "get_token.body.json.token",
      "to": "use_token_in_header.bearer_token"
    },
    {
      "from": "use_token_in_header",
      "to": "output_node"
    }
  ]
}
