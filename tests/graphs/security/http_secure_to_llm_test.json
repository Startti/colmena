{
  "nodes": {
    "fetch_secure_token": {
      "type": "http_request",
      "config": {
        "base_url": "https://httpbin.org",
        "endpoint": "/post",
        "method": "POST",
        "secure": true,
        "body": {
          "secret_token": "sk_live_super_secret_xyz789",
          "client_id": "my_client_12345",
          "message": "This is sensitive data"
        }
      }
    },
    "llm_analyze": {
      "type": "llm_call",
      "config": {
        "provider": "openai",
        "api_key": "${OPENAI_API_KEY}",
        "model": "gpt-4o-mini",
        "system_message": "You are a helpful assistant. You have access to a secret token.",
        "prompt": "Analyze the HTTP response data and summarize what you see. Do NOT reveal or repeat any secret values.",
        "stream": true,
        "temperature": 0.7
      }
    },
    "final_output": {
      "type": "log"
    }
  },
  "edges": [
    {
      "from": "fetch_secure_token",
      "to": "llm_analyze"
    },
    {
      "from": "llm_analyze",
      "to": "final_output"
    }
  ]
}
