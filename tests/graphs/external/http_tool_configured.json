{
  "comment": "HTTP tools with node_schema. Two tools: fetch_users (GET with optional query params) and create_user (POST with dynamic body). Migrated from exposed_inputs (deprecated) to node_schema.",
  "metadata": {
    "category": "external",
    "features": ["node_schema", "http_tool", "llm_call"],
    "requires_env": ["OPENAI_API_KEY"]
  },
  "nodes": {
    "trigger": {
      "type": "trigger_webhook",
      "config": {
        "path": "/agent",
        "method": "POST",
        "test_payload": {
          "prompt": "Get all active users and then create a new user named Alice with email alice@example.com and phone 123-456-7890"
        }
      }
    },
    "agent": {
      "type": "llm_call",
      "config": {
        "provider": "openai",
        "api_key": "${OPENAI_API_KEY}",
        "model": "gpt-4o-mini",
        "system_message": "You are a helpful API assistant. Use the available tools to fetch and create users.",
        "enabled_tools": [
          "fetch_users",
          "create_user"
        ],
        "tool_configurations": {
          "fetch_users": {
            "name": "fetch_users",
            "node_type": "http_request",
            "description": "Fetch user data from the API. Optionally filter by providing query parameters.",
            "node_schema": {
              "base_url":  { "type": "string", "fixed": "https://jsonplaceholder.typicode.com" },
              "endpoint":  { "type": "string", "fixed": "/users" },
              "method":    { "type": "string", "fixed": "GET" },
              "query_params": {
                "type": "object",
                "properties": {
                  "id":       { "type": "string", "required": false, "description": "Filter by user ID" },
                  "username": { "type": "string", "required": false, "description": "Filter by username" }
                }
              }
            }
          },
          "create_user": {
            "name": "create_user",
            "node_type": "http_request",
            "description": "Create a new user. Provide name, email, and phone.",
            "node_schema": {
              "base_url": { "type": "string", "fixed": "https://jsonplaceholder.typicode.com" },
              "endpoint": { "type": "string", "fixed": "/users" },
              "method":   { "type": "string", "fixed": "POST" },
              "headers":  { "type": "object", "fixed": { "Content-Type": "application/json" } },
              "body": {
                "type": "object",
                "properties": {
                  "name":  { "type": "string", "required": true,  "description": "Full name of the user" },
                  "email": { "type": "string", "required": true,  "description": "Email address" },
                  "phone": { "type": "string", "required": false, "description": "Phone number (optional)" }
                }
              }
            }
          }
        }
      }
    },
    "log": {
      "type": "log"
    }
  },
  "edges": [
    {
      "from": "trigger",
      "to": "agent"
    },
    {
      "from": "agent",
      "to": "log"
    }
  ]
}
