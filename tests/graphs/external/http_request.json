{
  "nodes": {
    "my_webhook": {
      "type": "trigger_webhook",
      "config": {
        "path": "/test-http",
        "method": "POST",
        "test_payload": {
          "dummy": true
        }
      }
    },
    "http_call": {
      "type": "http_request",
      "config": {
        "base_url": "https://official-joke-api.appspot.com",
        "endpoint": "/random_joke",
        "method": "GET",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "log_step": {
      "type": "log"
    }
  },
  "edges": [
    {
      "from": "my_webhook",
      "to": "http_call"
    },
    {
      "from": "http_call",
      "to": "log_step"
    }
  ]
}