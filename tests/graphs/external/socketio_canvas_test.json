{
  "comment": "Test: LLM agent interacting with ADP canvas via Socket.IO tools",
  "metadata": {
    "category": "external",
    "features": [
      "socketio_tool",
      "llm_call",
      "node_schema"
    ],
    "requires_env": [
      "GEMINI_API_KEY",
      "ADP_API_URL",
      "ADP_SESSION_TOKEN",
      "ADP_ENVIRONMENT_ID"
    ]
  },
  "nodes": {
    "trigger": {
      "type": "input",
      "config": {
        "prompt": "peudes agregar otro nodo pegado al orchestador que me ayude a bsucar hoteles para el viaje"
      }
    },
    "agent": {
      "type": "llm_call",
      "config": {
        "provider": "gemini",
        "model": "gemini-2.5-flash",
        "api_key": "${GEMINI_API_KEY}",
        "connection_url": "${DATABASE_URL}",
        "system_message": "You are a canvas automation agent. You can load the canvas state and create/update/delete nodes on a visual canvas. Always load the canvas state first to understand the current layout before making changes.",
        "temperature": 0.0,
        "stream": false,
        "enabled_tools": [
          "load_canvas",
          "create_canvas_node",
          "update_canvas_node",
          "delete_canvas_node"
        ],
        "tool_configurations": {
          "load_canvas": {
            "name": "load_canvas",
            "node_type": "socketio_request",
            "description": "Load the current canvas state for the environment. Returns all existing nodes, edges, and groups.",
            "node_schema": {
              "url": {
                "type": "string",
                "fixed": "${ADP_API_URL}"
              },
              "namespace": {
                "type": "string",
                "fixed": "/canvas"
              },
              "event": {
                "type": "string",
                "fixed": "load_canvas_state"
              },
              "wait_event": {
                "type": "string",
                "fixed": "canvas_state_loaded"
              },
              "cookies": {
                "type": "string",
                "fixed": "__Secure-better-auth.session_token=${ADP_SESSION_TOKEN}"
              },
              "timeout_ms": {
                "type": "integer",
                "fixed": 15000
              },
              "payload": {
                "type": "object",
                "properties": {
                  "environmentId": {
                    "type": "string",
                    "fixed": "${ADP_ENVIRONMENT_ID}"
                  }
                }
              }
            }
          },
          "create_canvas_node": {
            "name": "create_canvas_node",
            "node_type": "socketio_request",
            "description": "Create a new node on the canvas. The 'node' parameter must be a JSON object with: type (string, e.g. 'chatInput', 'llmCall'), category (string, e.g. 'trigger', 'ai', 'tools', 'logic', 'output'), position ({x: number, y: number}), and data ({label: string, config?: object}).",
            "node_schema": {
              "url": {
                "type": "string",
                "fixed": "${ADP_API_URL}"
              },
              "namespace": {
                "type": "string",
                "fixed": "/canvas"
              },
              "event": {
                "type": "string",
                "fixed": "create_node"
              },
              "cookies": {
                "type": "string",
                "fixed": "__Secure-better-auth.session_token=${ADP_SESSION_TOKEN}"
              },
              "timeout_ms": {
                "type": "integer",
                "fixed": 15000
              },
              "payload": {
                "type": "object",
                "properties": {
                  "environmentId": {
                    "type": "string",
                    "fixed": "${ADP_ENVIRONMENT_ID}"
                  },
                  "node": {
                    "type": "object",
                    "required": true,
                    "description": "Node definition: {type: string, category: string, position: {x: number, y: number}, data: {label: string, config?: object}}"
                  }
                }
              }
            }
          },
          "update_canvas_node": {
            "name": "update_canvas_node",
            "node_type": "socketio_request",
            "description": "Update an existing node on the canvas. Provide the node ID and an updates object with the fields to change.",
            "node_schema": {
              "url": {
                "type": "string",
                "fixed": "${ADP_API_URL}"
              },
              "namespace": {
                "type": "string",
                "fixed": "/canvas"
              },
              "event": {
                "type": "string",
                "fixed": "update_node"
              },
              "cookies": {
                "type": "string",
                "fixed": "__Secure-better-auth.session_token=${ADP_SESSION_TOKEN}"
              },
              "timeout_ms": {
                "type": "integer",
                "fixed": 15000
              },
              "payload": {
                "type": "object",
                "properties": {
                  "environmentId": {
                    "type": "string",
                    "fixed": "${ADP_ENVIRONMENT_ID}"
                  },
                  "id": {
                    "type": "string",
                    "required": true,
                    "description": "The ID of the node to update"
                  },
                  "updates": {
                    "type": "object",
                    "required": true,
                    "description": "Object with the fields to update on the node"
                  }
                }
              }
            }
          },
          "delete_canvas_node": {
            "name": "delete_canvas_node",
            "node_type": "socketio_request",
            "description": "Delete a node from the canvas by its ID.",
            "node_schema": {
              "url": {
                "type": "string",
                "fixed": "${ADP_API_URL}"
              },
              "namespace": {
                "type": "string",
                "fixed": "/canvas"
              },
              "event": {
                "type": "string",
                "fixed": "delete_node"
              },
              "cookies": {
                "type": "string",
                "fixed": "__Secure-better-auth.session_token=${ADP_SESSION_TOKEN}"
              },
              "timeout_ms": {
                "type": "integer",
                "fixed": 15000
              },
              "payload": {
                "type": "object",
                "properties": {
                  "environmentId": {
                    "type": "string",
                    "fixed": "${ADP_ENVIRONMENT_ID}"
                  },
                  "nodeId": {
                    "type": "string",
                    "required": true,
                    "description": "The ID of the node to delete"
                  }
                }
              }
            }
          }
        }
      }
    },
    "log_result": {
      "type": "log"
    }
  },
  "edges": [
    {
      "from": "trigger",
      "to": "agent"
    },
    {
      "from": "agent.result",
      "to": "log_result"
    }
  ]
}