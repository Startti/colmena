{
    "nodes": {
        "trigger": {
            "type": "input",
            "config": {
                "data": {
                    "prompt": "I am traveling to Aspen, Colorado for a 3-day ski trip. Please plan what I need to bring, and estimate a budget based on the items."
                }
            }
        },
        "planner": {
            "type": "planner",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "verbose": false,
                "agents": [
                    "clothing_expert",
                    "gear_expert",
                    "budget_expert"
                ],
                "system_message": "Read the user's trip request and break it down into tasks. Create one task for clothing_expert and one for gear_expert (these should be in phase 1, parallel=true). Then, create a third task for budget_expert that depends on the clothing and gear tasks to calculate the total cost (this MUST be in a higher phase, parallel=false)."
            }
        },
        "orchestrator_node": {
            "type": "orchestrator",
            "config": {
                "verbose": false,
                "include_extra_info": false
            }
        },
        "clothing_expert": {
            "type": "llm_call",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "verbose": false,
                "description": "Specialist in clothing, apparel, and wearable items for any trip or activity.",
                "system_message": "You are a professional clothing stylist. Recommend exactly 1 to 2 essential clothing items for the given trip details. Output a very short bulleted list (max 2 items) with estimated prices. Be brief.",
                "write_to_memory": true,
                "stream": false
            }
        },
        "gear_expert": {
            "type": "llm_call",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "verbose": false,
                "description": "Specialist in equipment, tools, and sports gear for activities.",
                "system_message": "You are a professional ski equipment outfitter. Recommend exactly 1 to 2 essential gear items for the given trip details. Output a very short bulleted list (max 2 items) with estimated prices. Be brief.",
                "write_to_memory": true,
                "stream": false
            }
        },
        "budget_expert": {
            "type": "llm_call",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "verbose": false,
                "description": "Specialist in finance and budget estimation. Takes lists of items and calculates a total expected cost.",
                "system_message": "You are a travel budget estimator. Analyze the given lists of clothing and gear, and provide a very brief budget estimate with a final total. Keep it to 2-3 lines maximum.",
                "write_to_memory": true,
                "stream": false
            }
        },
        "critic": {
            "type": "critic",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "verbose": false,
                "include_extra_info": false,
                "agents": [
                    "clothing_expert",
                    "gear_expert",
                    "budget_expert"
                ],
                "system_message": "You are reviewing results for a ski trip packing assistant. Be very brief. If the results look reasonable, set task_ok=true and add_tasks=[]. Only add 1 task at most if something critical is missing."
            }
        },
        "phase_reactor": {
            "type": "reactor",
            "trigger_on": "FINISHED_PHASE",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "verbose": false,
                "system_message": "You are summarizing the results of a completed phase. Write a single sentence summary. Set task_ok=true."
            }
        },
        "final_reactor": {
            "type": "reactor",
            "trigger_on": "FINISHED",
            "config": {
                "provider": "gemini",
                "model": "gemini-2.5-flash",
                "api_key": "${GEMINI_API_KEY}",
                "verbose": false,
                "system_message": "You are the final step in a ski trip planning assistant. Combine everything into a 2-3 line summary covering clothing, gear, and budget. Set task_ok=true."
            }
        },
        "final_output": {
            "type": "output",
            "trigger_on": "FINISHED"
        }
    },
    "edges": [
        {
            "from": "trigger.output.result.prompt",
            "to": "planner.texts.request"
        },
        {
            "from": "planner.output.result",
            "to": "orchestrator_node.plan"
        },
        {
            "from": "orchestrator_node.output.result.dispatched_agents.clothing_expert.task",
            "to": "clothing_expert.prompt"
        },
        {
            "from": "orchestrator_node.output.result.dispatched_agents.clothing_expert.id",
            "to": "clothing_expert.task_id"
        },
        {
            "from": "orchestrator_node.output.result.dispatched_agents.gear_expert.task",
            "to": "gear_expert.prompt"
        },
        {
            "from": "orchestrator_node.output.result.dispatched_agents.gear_expert.id",
            "to": "gear_expert.task_id"
        },
        {
            "from": "orchestrator_node.output.result.dispatched_agents.budget_expert.task",
            "to": "budget_expert.prompt"
        },
        {
            "from": "orchestrator_node.output.result.dispatched_agents.budget_expert.id",
            "to": "budget_expert.task_id"
        },
        {
            "from": "clothing_expert.output.result",
            "to": "critic.texts.clothing_result"
        },
        {
            "from": "gear_expert.output.result",
            "to": "critic.texts.gear_result"
        },
        {
            "from": "budget_expert.output.result",
            "to": "critic.texts.budget_result"
        },
        {
            "from": "orchestrator_node.output.result.phase_tasks",
            "to": "phase_reactor.texts.phase_tasks"
        },
        {
            "from": "orchestrator_node.output.extra_info.current_phase",
            "to": "phase_reactor.phase"
        },
        {
            "from": "orchestrator_node.output.result.all_tasks",
            "to": "final_reactor.texts.agent_results"
        },
        {
            "from": "orchestrator_node.output.extra_info.phase_summaries",
            "to": "final_reactor.texts.phase_summaries"
        },
        {
            "from": "trigger.output.result.prompt",
            "to": "final_reactor.texts.user_request"
        },
        {
            "from": "phase_reactor.output.result",
            "to": "orchestrator_node.trigger",
            "cyclic": true
        },
        {
            "from": "critic.output.result",
            "to": "orchestrator_node.trigger",
            "cyclic": true
        },
        {
            "from": "final_reactor.output.result",
            "to": "final_output.input"
        }
    ]
}