":{"type":"string","required":true,"description":"SQL SELECT query."}}},"monitor_stock":{"name":"monitor_stock","node_type":"sql_query","description":"Identify items below their reorder point (read-only).","summary":"SELECT items where qty <= reorder_point.","skills":["stock-monitor-playbook"],"node_schema":{"connection_url":{"type":"string","fixed":"${DATABASE_URL_GRAPHS}"},"permissions":{"type":"object","fixed":{"preset":"read_only","allowed_schemas":["roleplay_t22"]}},"runtime_limits":{"type":"object","fixed":{"max_rows":50,"statement_timeout_ms":15000}},"guardrail_enabled":{"type":"boolean","fixed":true},"guardrail_llm":{"type":"object","fixed":{"enabled":false}},"query":{"type":"string","required":true,"description":"SQL SELECT query."}}}},"prompt":"¿Qué productos están por debajo del punto de reorden? Si hay alguno crítico, registra una compra de 30 unidades para reponerlo."},"inputs":{"_setup_done":{"rows_affected":4}}}

