data: {"type":"node-start","node_id":"agent","node_type":"llm_call","config":{"provider":"google","model":"gemini-2.5-flash","api_key":"${GEMINI_API_KEY}","lazy_tool_loading":true,"system_message":"You are an inventory operations assistant with three role-specific tools: cargar_inventario (record stock movements), consultar_ventas (analyze sales data), and monitor_stock (identify items below reorder point). A single user request may require multiple tools in sequence — for example, identifying critical stock (monitor_stock) and then recording the purchase to replenish it (cargar_inventario). Always describe a tool the first time you need it to see its playbook, then chain the tools yourself to fulfill the user's intent end-to-end. Do not ask the user to invoke a tool manually — you have access to all three; switch between them as needed.","skills":{"paths":["./tests/graphs/skills/inventory_roleplay"]},"tool_configurations":{"cargar_inventario":{"name":"cargar_inventario","node_type":"sql_query","description":"Record inventory movements (purchases, sales, returns, adjustments).","summary":"Insert into transactions + update inventory.qty for a SKU.","skills":["inventory-writer-playbook"],"node_schema":{"connection_url":{"type":"string","fixed":"${DATABASE_URL_GRAPHS}"},"permissions":{"type":"object","fixed":{"preset":"read_write","allowed_schemas":["roleplay_t22"]}},"runtime_limits":{"type":"object","fixed":{"max_rows":50,"statement_timeout_ms":15000}},"guardrail_enabled":{"type":"boolean","fixed":true},"guardrail_llm":{"type":"object","fixed":{"enabled":false}},"query":{"type":"string","required":true,"description":"SQL DML statement(s) that record the movement."}}},"consultar_ventas":{"name":"consultar_ventas","node_type":"sql_query","description":"Analyze sales and stock movement data (read-only).","summary":"SELECT queries over transactions and inventory tables.","skills":["inventory-analyst-playbook"],"node_schema":{"connection_url":{"type":"string","fixed":"${DATABASE_URL_GRAPHS}"},"permissions":{"type":"object","fixed":{"preset":"read_only","allowed_schemas":["roleplay_t22"]}},"runtime_limits":{"type":"object","fixed":{"max_rows":50,"statement_timeout_ms":15000}},"guardrail_enabled":{"type":"boolean","fixed":true},"guardrail_llm":{"type":"object","fixed":{"enabled":false}},"query":{"type":"string","required":true,"description":"SQL SELECT query."}}},"monitor_stock":{"name":"monitor_stock","node_type":"sql_query","description":"Identify items below their reorder point (read-only).","summary":"SELECT items where qty <= reorder_point.","skills":["stock-monitor-playbook"],"node_schema":{"connection_url":{"type":"string","fixed":"${DATABASE_URL_GRAPHS}"},"permissions":{"type":"object","fixed":{"preset":"read_only","allowed_schemas":["roleplay_t22"]}},"runtime_limits":{"type":"object","fixed":{"max_rows":50,"statement_timeout_ms":15000}},"guardrail_enabled":{"type":"boolean","fixed":true},"guardrail_llm":{"type":"object","fixed":{"enabled":false}},"query":{"type":"string","required":true,"description":"SQL SELECT query."}}}},"prompt":"¿Qué productos están por debajo del punto de reorden? Si hay alguno crítico, registra una compra de 30 unidades para reponerlo."},"inputs":{"_setup_done":{"rows_affected":4}}}

